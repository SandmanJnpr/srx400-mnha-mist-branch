set routing-instances WAN-VR interface ge-0/0/5.0
set routing-instances lan routing-options rib lan.inet6.0 static route ::/0 next-table WAN-VR.inet6.0
set routing-instances lan routing-options static route 0.0.0.0/0 next-table WAN-VR.inet.0
set routing-instances lan routing-options instance-import vpn_OrgOverlay_bgp
set routing-instances lan system services dhcp-local-server active-leasequery peer-address 10.10.10.3
set routing-instances lan system services dhcp-local-server active-leasequery timeout 60
set routing-instances lan system services dhcp-local-server active-leasequery idle-timeout 10
set routing-instances vpn_OrgOverlay routing-options autonomous-system 65000
set routing-instances vpn_OrgOverlay protocols bgp group OrgOverlay_overlay export IOT-LP
set routing-instances vpn_OrgOverlay protocols bgp group OrgOverlay_overlay export OrgOverlay_advertise
set routing-instances vpn_OrgOverlay protocols bgp group OrgOverlay_overlay bfd-liveness-detection minimum-interval 1000
set routing-instances vpn_OrgOverlay protocols bgp group OrgOverlay_overlay bfd-liveness-detection multiplier 3
set routing-options autonomous-system 65001
set routing-options static route 0.0.0.0/0 qualified-next-hop <mgmt-gateway> preference 1
set routing-options static route 10.255.1.2/32 next-hop 10.255.0.2
set routing-options rib-groups WAN-LEAK import-rib WAN-VR.inet.0
set routing-options rib-groups WAN-LEAK import-rib lan.inet.0
set routing-options rib-groups WAN-LEAK import-rib GUEST-VR.inet.0
set routing-options rib-groups WAN-LEAK import-policy WAN-LEAK-POL
set protocols router-advertisement interface ge-0/0/2.0
set protocols router-advertisement interface ge-0/0/3.0 prefix 2001:db8:2000:1::/64
set protocols router-advertisement interface ge-0/0/3.20 prefix 2001:db8:2000:2::/64
set protocols router-advertisement interface ge-0/0/3.40 prefix 2001:db8:2000:4::/64
set protocols router-advertisement interface ge-0/0/3.50 prefix 2001:db8:2000:5::/64
set protocols router-advertisement interface ge-0/0/3.60 prefix 2001:db8:2000:6::/64
set protocols lldp port-id-subtype interface-name
set protocols lldp port-description-type interface-alias
set protocols lldp interface all
set protocols lldp-med interface all
